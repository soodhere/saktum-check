{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saktum.dev/schemas/receipt/0.1.json",
  "title": "Saktum receipt",
  "description": "A signed record of one call's outcome. Signatures use public-key cryptography so any third party can verify them without a shared secret.",
  "type": "object",
  "required": [
    "receiptFormat",
    "envelope",
    "outcome",
    "issuedAt",
    "signatures"
  ],
  "additionalProperties": false,
  "properties": {
    "receiptFormat": {
      "const": "0.1"
    },
    "envelope": {
      "$ref": "https://saktum.dev/schemas/envelope/0.1.json"
    },
    "outcome": {
      "enum": [
        "allow",
        "deny",
        "error"
      ]
    },
    "reason": {
      "type": "string"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "alg",
          "kid",
          "jws"
        ],
        "properties": {
          "alg": {
            "const": "EdDSA"
          },
          "kid": {
            "type": "string"
          },
          "jws": {
            "type": "string"
          }
        }
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 500,
      "description": "One plain-language sentence: what happened, which rule applied, who could have stopped it."
    },
    "context": {
      "$ref": "https://saktum.dev/schemas/envelope/0.1.json#/properties/context"
    },
    "compensates": {
      "type": "string",
      "description": "Optional (Baseline 8.4): id of the original envelope or receipt that this call reverses (compensation transaction)."
    }
  }
}
