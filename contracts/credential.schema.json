{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saktum.dev/contracts/credential.schema.json",
  "title": "credential.schema.json",
  "type": "object",
  "required": [
    "credentialFormat",
    "id",
    "type",
    "subject",
    "issuer",
    "issuedAt",
    "expires",
    "signature"
  ],
  "properties": {
    "credentialFormat": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^cred_"
    },
    "type": {
      "enum": [
        "organisation",
        "member",
        "agent"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:key:"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "domain": {
          "type": "string",
          "maxLength": 253
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "manifest": {
          "type": "string"
        }
      }
    },
    "issuer": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^did:key:"
        },
        "name": {
          "type": "string",
          "maxLength": 200
        },
        "domain": {
          "type": "string",
          "maxLength": 253
        },
        "role": {
          "type": "string",
          "maxLength": 100
        },
        "manifest": {
          "type": "string"
        }
      }
    },
    "chain": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "issuedAt": {
      "type": "string"
    },
    "expires": {
      "type": "string"
    },
    "signature": {
      "type": "object",
      "required": [
        "kid"
      ]
    }
  }
}
